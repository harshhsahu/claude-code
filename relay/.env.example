# --- MSG91 ---
MSG91_AUTHKEY=your_msg91_authkey
MSG91_INTEGRATED_NUMBER=919800000000   # your WhatsApp Business number, digits only

# --- Security ---
WEBHOOK_SECRET=change-me-to-a-long-random-string   # webhook URL: https://<host>/wa/<this>
ALLOWED_NUMBERS=919812345678                       # your personal WhatsApp number(s)

# --- Where messages go ---
MODE=session                    # session | routine
CLAUDE_SESSION_ID=session_xxx   # session mode: from the claude.ai/code/<id> URL
# ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/trig_xxx/fire
# ROUTINE_TOKEN=sk-ant-oat01-xxx

PORT=8080
# DEBUG=1   # log raw webhook payloads (do this on first run)
